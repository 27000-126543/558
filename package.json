{
  "name": "enterprise-shuttle-system",
  "version": "1.0.0",
  "description": "企业班车通勤调度与员工乘车管理桌面系统",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "webpack serve --mode development --config webpack.renderer.js",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --mode production --config webpack.renderer.js"
  },
  "keywords": ["electron", "shuttle", "enterprise"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "electron": "^31.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.6.0",
    "ts-loader": "^9.5.0",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "antd": "^5.16.0",
    "dayjs": "^1.11.10",
    "sql.js": "^1.10.3",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "react-router-dom": "^6.22.0",
    "@ant-design/icons": "^5.3.6"
  }
}
